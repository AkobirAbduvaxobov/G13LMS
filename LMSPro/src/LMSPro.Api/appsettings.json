{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log.txt",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Data Source=localhost\\SQLDEV;User ID=sa;Password=1;Initial Catalog=LMSPro;TrustServerCertificate=True;",
          "tableName": "Logs",
          "autoCreateSqlTable": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "ConnectionStrings": {
    "DatabaseConnection": "Data Source=localhost\\SQLDEV;User ID=sa;Password=1;Initial Catalog=LMSPro;TrustServerCertificate=True;",
    "Redis": "localhost:6379"
  },

  "CacheSettings": {
    "Courses": {
      "AbsoluteExpirationMinutes": 10,
      "SlidingExpirationMinutes": 5
    },
    "Questions": {
      "AbsoluteExpirationMinutes": 10,
      "SlidingExpirationMinutes": 5
    }
  },

  "AllowedHosts": "*"
}
