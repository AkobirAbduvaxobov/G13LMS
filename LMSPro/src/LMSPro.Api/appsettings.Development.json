{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log.txt",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Server=localhost,1433;Database=LMSPro;User Id=sa;Password=StrongPass123!;TrustServerCertificate=True;",
          "tableName": "Logs",
          "autoCreateSqlTable": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "ConnectionStrings": {
    "DatabaseConnection": "Server=localhost,1433;Database=LMSPro;User Id=sa;Password=StrongPass123!;TrustServerCertificate=True;",
    "Redis": "localhost:6379"
  },

  "CacheSettings": {
    "Courses": {
      "AbsoluteExpirationMinutes": 10,
      "SlidingExpirationMinutes": 5
    }
  }
}